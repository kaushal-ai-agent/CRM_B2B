# ==============================================================================
# CRM B2BTrader — Environment Configuration Template
# Copy this file to .env and adjust variables as needed for your environment.
# ==============================================================================

# ── Django Backend Settings ───────────────────────────────────────────────────
DJANGO_SECRET_KEY=django-insecure-replace-this-in-production-with-a-random-50-char-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,crm_backend,0.0.0.0
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# Database Configuration (Defaults to SQLite; configure PostgreSQL for production)
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=crm_b2btrader
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_HOST=localhost
# DB_PORT=5432

# Initial Seed Users
CRM_OWNER_USERNAME=owner
CRM_OWNER_PASSWORD=owner123
CRM_OWNER_NAME=Rahul Sharma

CRM_SALES1_USERNAME=amit.sales
CRM_SALES1_PASSWORD=sales123
CRM_SALES1_NAME=Amit Verma

CRM_SALES2_USERNAME=priya.sales
CRM_SALES2_PASSWORD=sales123
CRM_SALES2_NAME=Priya Nair

# ── AI Agent Service (FastAPI / LangGraph) ────────────────────────────────────
OPENROUTER_API_KEY=your-openrouter-api-key-here
ROUTER_MODEL_NAME=openai/gpt-4o-mini
SYNTHESIS_MODEL_NAME=openai/gpt-4o-mini
CRM_DATABASE_URL=sqlite:///db.sqlite3
AUDIT_DATABASE_URL=sqlite:///agent_service/agent_audit.db
MAX_GRAPH_ITERATIONS=5
AGENT_PORT=8001

# ── Instagram Channel Integration (Optional) ─────────────────────────────────
IG_ENABLED=false
IG_VERIFY_TOKEN=your-webhook-verify-token
IG_ACCESS_TOKEN=your-instagram-graph-api-token
IG_APP_ID=your-meta-app-id
IG_APP_SECRET=your-meta-app-secret
IG_ACCOUNT_ID=your-instagram-business-account-id

# ── Frontend Settings ─────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:8000/api/v1
VITE_AGENT_API_BASE=http://localhost:8001
