# =============================================================================
# Agent Service — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# =============================================================================

# ── OpenRouter API ──────────────────────────────────────────────────────────
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ── LLM Model Selection ────────────────────────────────────────────────────
# Fast/cheap model for intent classification
ROUTER_MODEL_NAME=openai/gpt-4o-mini
# High-precision model for grounded response synthesis
SYNTHESIS_MODEL_NAME=openai/gpt-4o

# ── Custom Headers (recommended by OpenRouter) ─────────────────────────────
HTTP_REFERER=https://crm-b2btrader.local
X_TITLE=CRM_B2Btrader Agent

# ── Database ────────────────────────────────────────────────────────────────
# CRM_DATABASE_URL=sqlite:///path/to/db.sqlite3
# AUDIT_DATABASE_URL=sqlite:///path/to/agent_audit.db

# ── Routing & Guardrails ───────────────────────────────────────────────────
CONFIDENCE_THRESHOLD=0.80
MAX_CONTEXT_TURNS=5
MAX_GRAPH_ITERATIONS=3
QUERY_TIMEOUT_SECONDS=5

# ── LLM Parameters ─────────────────────────────────────────────────────────
ROUTER_TEMPERATURE=0.0
SYNTHESIS_TEMPERATURE=0.1
LLM_REQUEST_TIMEOUT=30

# ── Server ──────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8100
